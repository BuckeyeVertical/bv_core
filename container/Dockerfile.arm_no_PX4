FROM ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    ros-dev-tools \
    git \
    cmake \
    build-essential \
    gnupg2 \
    curl \
    lsb-release \
    software-properties-common \
    libeigen3-dev \
    ca-certificates \
    wget \
 && (rosdep init || true) \
 && wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list \
 && apt-get update \
 && rosdep update \
 && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    gz-sim8-cli \
    libgz-sim8-plugins \
    python3-gz-transport13 \
    ros-humble-mavros \
    ros-humble-mavros-msgs \
    ros-humble-cv-bridge \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    python3-aiohttp \
    python3-gi \
    python3-opencv \
    python3-pil \
    gir1.2-gstreamer-1.0 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    geographiclib-tools \
 && /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /bv_ws
RUN mkdir -p /bv_ws/src

COPY requirements.txt /tmp/bv_core-requirements.txt
RUN python3 -m pip install --upgrade pip && \
    pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.11.0+cpu \
      torchvision==0.26.0+cpu && \
    pip install --no-cache-dir -r /tmp/bv_core-requirements.txt

COPY container/entrypoint.sh /entrypoint.sh
COPY container/ros_setup.sh /opt/bv/ros_setup.sh
RUN chmod +x /entrypoint.sh /opt/bv/ros_setup.sh && \
    printf '%s\n' 'source /opt/bv/ros_setup.sh' >> /root/.bashrc

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
